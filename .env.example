# Copy to .env and fill in. Never commit .env.
# A random secret for signed links and sign-in cookies (at least 32 characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TIDEGATE_SECRET_KEY=
# The admin password hash: docker compose run --rm --no-deps web cli passwd
TIDEGATE_ADMIN_PASSWORD_HASH=
TZ=UTC

# Where Postfix listens. A gateway in front of your mail server takes port 25 on all addresses.
SMTP_BIND=0.0.0.0
SMTP_PORT=25
# The web console. Keep it on 127.0.0.1 and put a TLS reverse proxy in front for the release pages (see README).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# The stack's private network. Change these only if 172.31.240.0/24 is already used on this host.
TIDEGATE_SUBNET=172.31.240.0/24
TIDEGATE_GATEWAY=172.31.240.1
TIDEGATE_MTA_IP=172.31.240.25
TIDEGATE_DNS_IP=172.31.240.53
TIDEGATE_BRIDGE=br-tidegate
