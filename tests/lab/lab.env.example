# Settings for the lab run (tests/lab/run.sh writes tests/lab/lab.env from this file).
COMPOSE_PROJECT_NAME=tidegate-lab
TIDEGATE_CONFIG_DIR=./tests/lab/config
TZ=America/Denver
# Ports are not published in the lab (tests/lab/compose.lab.yml resets them); these only fill in the base file.
SMTP_BIND=127.0.0.1
SMTP_PORT=2526
WEB_BIND=127.0.0.1
WEB_PORT=8081
TIDEGATE_SUBNET=172.31.241.0/24
TIDEGATE_GATEWAY=172.31.241.1
TIDEGATE_MTA_IP=172.31.241.25
TIDEGATE_DNS_IP=172.31.241.53
TIDEGATE_BRIDGE=br-tidegate-lab
