# The edge: a stand-in for an existing Postfix that delivers arc-codex.test mail to a local Maildir.
compatibility_level = 3.9
myhostname = mail.arc-codex.test
mydomain = arc-codex.test
myorigin = $myhostname
mydestination = $myhostname, arc-codex.test, localhost.$mydomain, localhost
# 172.31.241.20 is the edge's own address: on a real server this is its LAN address (in mynetworks).
mynetworks = 127.0.0.0/8, 172.31.241.20/32
mynetworks_style = host
inet_interfaces = all
inet_protocols = ipv4
virtual_alias_maps = texthash:/etc/postfix/virtual
home_mailbox = Maildir/
alias_maps =
alias_database =
maillog_file = /dev/stdout
message_size_limit = 10240000
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
# Replica only: the test client may claim an internet address with XCLIENT.
smtpd_authorized_xclient_hosts = 172.31.241.1
# --- Tidegate: mail from outside goes through it; its own deliveries back here (OK) skip that step. ---
smtpd_recipient_restrictions = permit_mynetworks, check_client_access cidr:/etc/postfix/tidegate_return.cidr, check_recipient_access texthash:/etc/postfix/tidegate_filter, reject_unauth_destination
